# Build the tunmap server as a static binary, then ship it on scratch.
FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/tunmap-server ./cmd/server

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /out/tunmap-server /usr/local/bin/tunmap-server
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/tunmap-server"]
